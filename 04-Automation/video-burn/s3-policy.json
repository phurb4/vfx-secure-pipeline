{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOutput",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::vfx-modelado-output/*"
    },
    {
      "Sid": "WriteDailies",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::vfx-dailies/*"
    }
  ]
}